{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dcc-mcp/marketplace/schemas/marketplace-v1.schema.json",
  "title": "DCC-MCP Marketplace Catalog v1",
  "type": "object",
  "required": ["name", "schemaVersion", "version", "skills"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "schemaVersion": {
      "const": "1"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "interface": {
      "type": "object",
      "required": ["displayName", "description"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "installRoot": {
      "type": "string",
      "pattern": "^~/.dcc-mcp/marketplace/\\{dcc\\}/\\{name\\}$"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "skillEntry": {
      "type": "object",
      "required": [
        "name",
        "description",
        "version",
        "dcc",
        "tags",
        "category",
        "maintainer",
        "minCoreVersion",
        "source",
        "policy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" },
        "dcc": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        },
        "category": {
          "enum": ["Skills", "Asset Providers", "Studio", "Infrastructure"]
        },
        "maintainer": { "type": "string", "minLength": 1 },
        "minCoreVersion": { "$ref": "#/$defs/semver" },
        "source": { "$ref": "#/$defs/source" },
        "policy": { "$ref": "#/$defs/policy" },
        "requires": { "$ref": "#/$defs/requires" },
        "license": { "type": "string", "minLength": 1 },
        "docs": { "type": "string", "format": "uri" },
        "icon": { "type": "string", "format": "uri" },
        "lifecycle": {
          "enum": ["active", "deprecated", "experimental"]
        },
        "assetContract": {
          "enum": ["descriptor-v1"]
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle": { "const": "deprecated" } },
            "required": ["lifecycle"]
          },
          "then": { "required": ["replacedBy"] }
        }
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["git", "zip"] },
        "url": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^(?:sha256:)?[a-fA-F0-9]{64}$"
        },
        "skillRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "git" } } },
          "then": { "required": ["ref"] }
        },
        {
          "if": { "properties": { "type": { "const": "zip" } } },
          "then": { "required": ["sha256"] }
        }
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["installation"],
      "properties": {
        "installation": {
          "enum": ["available", "installed_by_default", "not_available"]
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "bins": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "python": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
