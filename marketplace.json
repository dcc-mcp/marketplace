{
  "name": "dcc-mcp-official",
  "version": "1.0.0",
  "interface": {
    "displayName": "DCC-MCP Official Marketplace",
    "description": "Curated DCC-MCP skill packs, asset providers, and adapter bundles."
  },
  "installRoot": "~/.dcc-mcp/marketplace/{dcc}/{name}",
  "skills": [
    {
      "name": "dcc-mcp-maya-skills",
      "description": "Official Maya skill pack for DCC-MCP — scene, render, and rigging tools",
      "version": "1.0.0",
      "dcc": ["maya"],
      "tags": ["skills", "maya", "official", "domain"],
      "category": "Skills",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.15.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-mcp-maya",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      }
    },
    {
      "name": "dcc-mcp-maya-mgear",
      "description": "mGear Shifter rigging integration for DCC-MCP — inspect, build, and manage mGear rigs",
      "version": "0.4.3",
      "dcc": ["maya"],
      "tags": ["skills", "maya", "rigging", "mgear"],
      "category": "Skills",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.18.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-mcp-maya-mgear",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      }
    },
    {
      "name": "dcc-mcp-blender-skills",
      "description": "Official Blender skill pack for DCC-MCP — modeling, shading, and render tools",
      "version": "1.0.0",
      "dcc": ["blender"],
      "tags": ["skills", "blender", "official", "domain"],
      "category": "Skills",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.15.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-mcp-blender",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      }
    },
    {
      "name": "dcc-mcp-houdini-skills",
      "description": "Official Houdini skill pack for DCC-MCP — VFX, procedural, and simulation tools",
      "version": "1.0.0",
      "dcc": ["houdini"],
      "tags": ["skills", "houdini", "official", "domain"],
      "category": "Skills",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.15.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-mcp-houdini",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      }
    },
    {
      "name": "dcc-ai-hunyuan3d",
      "description": "Tencent Cloud Hunyuan 3D generation for DCC-MCP — submit and query text/image-to-3D jobs",
      "version": "0.1.0",
      "dcc": ["maya", "blender", "houdini", "3dsmax"],
      "tags": ["skills", "ai", "hunyuan", "3d-generation"],
      "category": "Asset Providers",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.18.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-ai-hunyuan3d",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      },
      "requires": {
        "bins": ["tccli"]
      }
    },
    {
      "name": "dcc-ai-tripo3d",
      "description": "Tripo 3D generation for DCC-MCP — create, inspect, and download text/image/multiview tasks",
      "version": "0.1.0",
      "dcc": ["maya", "blender", "houdini", "3dsmax"],
      "tags": ["skills", "ai", "tripo", "3d-generation"],
      "category": "Asset Providers",
      "maintainer": "dcc-mcp",
      "minCoreVersion": "0.18.0",
      "source": {
        "type": "git",
        "url": "https://github.com/dcc-mcp/dcc-ai-tripo3d",
        "ref": "main"
      },
      "policy": {
        "installation": "available"
      },
      "requires": {
        "env": ["TRIPO_API_KEY"]
      }
    },
    {
      "name": "dcc-asset-polyhaven",
